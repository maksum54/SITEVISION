# URL Web App dari deployment Google Apps Script (apps-script/Code.gs)
# Contoh: https://script.google.com/macros/s/AKfycb.../exec
VITE_APPS_SCRIPT_URL=

# OAuth Client ID (Web application) dari Google Cloud Console, untuk "Masuk dengan Google".
# Harus sama dengan GOOGLE_CLIENT_ID di apps-script/Code.gs.
VITE_GOOGLE_CLIENT_ID=
